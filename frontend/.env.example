# Frontend environment (sanitized example — no real credentials)
# Copy to .env or .env.dev and fill in your values.

VITE_I18N_LOCALE=en
VITE_I18N_FALLBACK_LOCALE=en

# Backend API base URL (Caddy proxy) and direct URL
VITE_API_URL=/api
VITE_API_BASE_URL=https://localhost/api

# Optional legacy credentials used by some scripts/tests — leave empty by default.
VITE_API_USERNAME=
VITE_API_PASSWORD=
