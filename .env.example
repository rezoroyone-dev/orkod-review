DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password
DB_NAME=phealing
DB_HOST=db
DB_PORT=5432
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_USER=admin
DEBUG=false
JWT_SECRET=generate-a-random-256-bit-secret-here
CORS_ALLOWED_ORIGINS="https://yourdomain.com"
# GORM_LOG_LEVEL: 0=Silent, 1=Error, 2=Warn, 3=Info, 4=Verbose
GORM_LOG_LEVEL=1
# ENABLE_DB_MIGRATION: controls whether database migrations should run automatically (true/false)
ENABLE_DB_MIGRATION=true
DROP_ALL_TABLES=false
# Two-Factor Authentication (TOTP) Settings
TOTP_ENABLED=true
TOTP_ADMIN_ONLY=true
TOTP_ISSUER=Pranic Healing
